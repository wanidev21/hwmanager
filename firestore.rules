rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인 허용 계정 — Firestore config/access 문서의 emails 목록 (코드에 이메일을 두지 않음)
    // 추가·삭제: 회원 관리 화면(관리자) 또는 python scripts/access.py add|remove <email>
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/access).data.emails;
    }

    function isAdmin() {
      return allowed()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 본인 소유 문서 (user_id == 로그인 uid)
    function ownsExisting() {
      return allowed() && resource.data.user_id == request.auth.uid;
    }
    function ownsIncoming() {
      return allowed() && request.resource.data.user_id == request.auth.uid;
    }

    // ── 허용 계정 목록 ── (읽기: 허용 계정 — 로그인 시 접근 확인용, 쓰기: 관리자)
    match /config/access {
      allow read: if allowed();
      allow write: if isAdmin();
    }

    // ── 사용자 ──
    match /users/{uid} {
      allow read: if allowed();
      // 첫 로그인 시 본인 문서 생성 (role은 'user'로만)
      allow create: if allowed() && request.auth.uid == uid && request.resource.data.role == 'user';
      // 본인은 role 외 필드만 수정, 관리자는 모두 수정
      allow update: if isAdmin()
        || (allowed() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ── 개인 데이터 (본인 것만) ──
    match /kb_articles/{id}     { allow read, delete: if ownsExisting(); allow create: if ownsIncoming(); allow update: if ownsExisting() && ownsIncoming(); }
    match /tech_domains/{id}    { allow read, delete: if ownsExisting(); allow create: if ownsIncoming(); allow update: if ownsExisting() && ownsIncoming(); }
    match /tech_topics/{id}     { allow read, delete: if ownsExisting(); allow create: if ownsIncoming(); allow update: if ownsExisting() && ownsIncoming(); }
    match /tech_notes/{id}      { allow read, delete: if ownsExisting(); allow create: if ownsIncoming(); allow update: if ownsExisting() && ownsIncoming(); }
    match /releases/{id}        { allow read, delete: if ownsExisting(); allow create: if ownsIncoming(); allow update: if ownsExisting() && ownsIncoming(); }
    match /calendar_events/{id} { allow read, delete: if ownsExisting(); allow create: if ownsIncoming(); allow update: if ownsExisting() && ownsIncoming(); }

    // ── 공용 업무 데이터 (허용 계정 모두 읽기/쓰기) ──
    match /customers/{id}       { allow read, write: if allowed(); }
    match /projects/{id}        { allow read, write: if allowed(); }
    match /assets/{id}          { allow read, write: if allowed(); }
    match /tickets/{id} {
      allow read, write: if allowed();
      // 진행 기록: 모두 읽기, 작성자 본인만 수정 (by == 작성자 uid)
      match /logs/{logId} {
        allow read: if allowed();
        allow create: if allowed() && request.resource.data.by == request.auth.uid;
        allow update: if allowed() && resource.data.by == request.auth.uid
                      && request.resource.data.by == request.auth.uid;
        // 삭제는 팀 모두 허용 (티켓 삭제 시 다른 사람 기록도 함께 지워져야 하므로). 수정은 작성자만
        allow delete: if allowed();
      }
    }
    // 변경 이력: 모두 읽기, 본인 이름으로 추가만 (수정·삭제 불가)
    match /audit_logs/{id} {
      allow read: if allowed();
      allow create: if allowed() && request.resource.data.by == request.auth.uid;
    }
    match /internal_assets/{id} { allow read, write: if allowed(); }
    match /delivery_notes/{id}  { allow read, write: if allowed(); }
    match /delivery_items/{id}  { allow read, write: if allowed(); }

    // 그 외 컬렉션은 모두 차단 (기본값)
  }
}
